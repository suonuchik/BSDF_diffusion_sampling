<scene version="3.0.0">
    <default name="spp" value="64"/>
    <default name="width" value="512"/>
    <default name="height" value="512"/>
    <default name="max_depth" value="-1"/>

    <integrator type="path">
        <integer name="max_depth" value="$max_depth"/>
    </integrator>

    <!--
        カメラ: 正面やや上から円柱を見る
        円柱軸 = x 方向（左右に伸びる）
        繊維軸（ローカルx = dp/du = 円周方向）は円柱の周りを巻く向き
    -->
    <sensor type="perspective" id="camera">
        <string name="fov_axis" value="smaller" />
        <float name="fov" value="40.0" />
        <transform name="to_world">
            <lookat target="0, 0, 0"
                    origin="0, -4, 1.5"
                    up="0, 0, 1" />
        </transform>
        <sampler type="independent">
            <integer name="sample_count" value="$spp" />
        </sampler>
        <film type="hdrfilm" id="film">
            <integer name="width" value="$width" />
            <integer name="height" value="$height" />
            <string name="pixel_format" value="rgb" />
            <rfilter type="gaussian" />
        </film>
    </sensor>

    <!-- 指向性ライト（R ローブを際立たせる） -->
    <shape type="sphere" id="light-a">
        <point name="center" value="3, -5, 4"/>
        <float name="radius" value="0.3"/>
        <emitter type="area">
            <rgb name="radiance" value="80, 80, 75"/>
        </emitter>
    </shape>
    <shape type="sphere" id="light-b">
        <point name="center" value="-3, -4, 3"/>
        <float name="radius" value="0.3"/>
        <emitter type="area">
            <rgb name="radiance" value="50, 50, 48"/>
        </emitter>
    </shape>

    <!-- 環境マップ（ambient 照明 + 背景） -->
    <emitter type="envmap" id="emitter-envmap">
        <string name="filename" value="envmap.exr" />
        <transform name="to_world">
            <rotate y="1" angle="-180" />
            <matrix value="-0.224951 -0.000001 -0.974370 0.000000 -0.974370 0.000000 0.224951 0.000000 0.000000 1.000000 -0.000001 8.870000 0.000000 0.000000 0.000000 1.000000" />
        </transform>
        <float name="scale" value="1.5" />
    </emitter>

    <bsdf type="diffuse" id="bsdf-floor">
        <rgb name="reflectance" value="0.3 0.3 0.3" />
    </bsdf>

    <!-- idx=29: cotton BSDF -->
    <bsdf type="myyarnbsdf" id="bsdf-cotton">
        <integer name="idx" value="29"/>
        <vector name="albedo" value="1.0, 1.0, 1.0"/>
    </bsdf>


    <!--
        単一の太い円柱（1本の糸束）
        軸 = x 方向（-2 から +2）、半径 = 0.35
        円周方向がローカルx（繊維軸）になる
    -->
    <shape type="cylinder" id="shape-yarn">
        <point name="p0" value="-2, 0, 0"/>
        <point name="p1" value=" 2, 0, 0"/>
        <float name="radius" value="0.35"/>
        <ref name="bsdf" id="bsdf-cotton"/>
    </shape>


    <!-- 床 -->
    <shape type="rectangle" id="shape-floor">
        <transform name="to_world">
            <scale x="5" y="5"/>
            <translate z="-0.36"/>
        </transform>
        <ref name="bsdf" id="bsdf-floor"/>
    </shape>

</scene>
